{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ENVIRONMENT=test poetry run python -m pytest *)",
      "Bash(poetry run task lint)",
      "Bash(poetry run task mypy)",
      "Bash(poetry run task format)",
      "Bash(codex exec:*)",
      "Bash(grep *)",

      "Bash(npm run lint)",
      "Bash(npm run test *)",

      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git ls-tree *)",
      "Bash(awk *)",


      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh workflow list)",
      "Bash(gh workflow list *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)"

    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 2
  }
}
