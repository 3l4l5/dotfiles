{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh workflow list)",
      "Bash(gh workflow list *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)"

    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ]
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
